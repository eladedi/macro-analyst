# FRED API (free key from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Anthropic Claude API (server-side only)
ANTHROPIC_API_KEY=

# Twelve Data API (free key from https://twelvedata.com — 800 req/day).
# Covers all non-FRED metrics: DXY, equity indices, gold, silver, BTC, ETH.
TWELVE_DATA_API_KEY=

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the pooled "Transaction" string (port 6543) for the app + scripts.
DATABASE_URL=

# Supabase (optional — only if using supabase-js features later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Simple private auth (single shared secret)
AUTH_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
